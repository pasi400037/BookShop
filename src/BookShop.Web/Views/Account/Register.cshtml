@model RegisterInput
@{ ViewData["Title"]="Create account"; }
<section class="form-card"><p class="eyebrow">JOIN OUR READERS</p><h1>Create your account</h1><form method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="error"></div><div class="form-grid"><label>Full name<input asp-for="FullName"/><span asp-validation-for="FullName"></span></label><label>Date of birth<input asp-for="DateOfBirth"/><span asp-validation-for="DateOfBirth"></span></label><label>Phone<input asp-for="Phone"/><span asp-validation-for="Phone"></span></label><label>Email<input asp-for="Email"/><span asp-validation-for="Email"></span></label><label>Username<input asp-for="UserName"/><span asp-validation-for="UserName"></span></label><label>Password<input asp-for="Password"/><span asp-validation-for="Password"></span></label><label>State<input asp-for="State"/></label><label>City<input asp-for="City"/></label><label>Postal code<input asp-for="PostalCode"/></label><label class="wide">Address<textarea asp-for="Address"></textarea></label></div><button class="button">Create account</button></form><p>Already registered? <a asp-action="Login">Sign in</a></p></section>
