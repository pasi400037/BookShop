@{ ViewData["Title"]="Create administrator"; }
<section class="form-card narrow"><p class="eyebrow">ONE TIME SETUP</p><h1>Create the first administrator</h1><p>Enter the setup key supplied by the site owner. This page closes after the first administrator is created.</p><form method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="error"></div><label>Setup key<input name="setupKey" type="password" required/></label><label>Your name<input name="fullName" required maxlength="120"/></label><label>Username<input name="userName" required minlength="3" maxlength="60"/></label><label>Email<input name="email" type="email" required/></label><label>Password (12+ characters)<input name="password" type="password" required minlength="12"/></label><button class="button">Create administrator</button></form></section>
