@model BookInput
@{ ViewData["Title"]=string.IsNullOrEmpty(Model.Id)?"Add a book":"Edit book"; }
<section class="form-card"><p class="eyebrow">CATALOG</p><h1>@ViewData["Title"]</h1><form method="post" action="/admin/books/save" enctype="multipart/form-data">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="error"></div><div class="form-grid"><label>Title<input asp-for="Title"/><span asp-validation-for="Title"></span></label><label>Author<input asp-for="Author"/></label><label>Category<input asp-for="Category"/></label><label>Publisher<input asp-for="Publisher"/></label><label>Language<input asp-for="Language"/></label><label>Edition<input asp-for="Edition"/></label><label>Genres<input asp-for="Genres"/></label><label>Price<input asp-for="Price" type="number" step="0.01"/></label><label>List price<input asp-for="ListPrice" type="number" step="0.01"/></label><label>Stock<input asp-for="Stock" type="number"/></label><label>Cover image<input asp-for="Image" type="file" accept="image/jpeg,image/png,image/webp,image/gif"/><span asp-validation-for="Image"></span></label><label class="wide">Description<textarea asp-for="Description"></textarea></label><label class="check"><input asp-for="IsActive"/> Show this book in the shop</label></div><button class="button">Save book</button> <a href="/admin/books">Cancel</a></form></section>
