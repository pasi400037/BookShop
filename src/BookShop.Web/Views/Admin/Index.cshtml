@model IReadOnlyList<ShopOrder>
@{ ViewData["Title"]="Admin dashboard"; }
<section class="page-heading"><p class="eyebrow">SHOP CONTROL</p><h1>Admin dashboard</h1><div class="stats"><div><b>@ViewBag.BookCount</b><span>Books</span></div><div><b>@ViewBag.UserCount</b><span>Customers</span></div><div><b>@ViewBag.OrderCount</b><span>Orders</span></div></div></section><div class="admin-links"><a class="button" href="/admin/books">Manage books</a><a class="button secondary" href="/admin/users">Customers</a><a class="button secondary" href="/admin/orders">Orders</a></div><h2>Recent orders</h2><partial name="_OrdersTable" model="Model"/>
