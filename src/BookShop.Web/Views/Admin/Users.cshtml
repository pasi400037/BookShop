@model IReadOnlyList<ShopUser>
@{ ViewData["Title"]="Manage customers"; }
<section class="page-heading"><p class="eyebrow">ACCOUNTS</p><h1>Customers and users</h1></section><div class="table-wrap"><table><thead><tr><th>Name</th><th>Username</th><th>Email</th><th>Phone</th><th>Role</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var u in Model){<tr><td>@u.FullName</td><td>@u.UserName</td><td>@u.Email</td><td>@u.Phone</td><td>@u.Role</td><td>@(u.IsActive?"Active":"Inactive")</td><td><form method="post" action="/admin/users/@u.Id/toggle">@Html.AntiForgeryToken()<button class="link">@(u.IsActive?"Disable":"Enable")</button></form></td></tr>}</tbody></table></div>
