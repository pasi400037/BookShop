@model IReadOnlyList<ShopBook>
@{ ViewData["Title"]="Manage books"; }
<section class="section-heading"><div><p class="eyebrow">CATALOG</p><h1>Manage books</h1></div><a class="button" href="/admin/books/new">Add a book</a></section><div class="table-wrap"><table><thead><tr><th>Book</th><th>Category</th><th>Price</th><th>Stock</th><th>Visible</th><th></th></tr></thead><tbody>@foreach(var b in Model){<tr><td>@b.Title <small>by @b.Author</small></td><td>@b.Category</td><td>₹@b.Price.ToString("0.00")</td><td>@b.Stock</td><td>@(b.IsActive?"Yes":"No")</td><td class="actions"><a href="/admin/books/@b.Id/edit">Edit</a><form method="post" action="/admin/books/@b.Id/delete">@Html.AntiForgeryToken()<button class="link danger-text">Hide</button></form></td></tr>}</tbody></table></div>
