@model IEnumerable<ShopBook>
<div class="book-grid">@foreach(var book in Model){<article class="book-card"><a asp-controller="Books" asp-action="Details" asp-route-id="@book.Id"><img src="@book.ImagePath" alt="Cover of @book.Title"/><span class="category">@book.Category</span><h3>@book.Title</h3></a><p class="muted">by @book.Author</p><div class="price-row"><strong>₹@book.Price.ToString("0.00")</strong>@if(book.ListPrice>book.Price){<del>₹@book.ListPrice.ToString("0.00")</del>}</div><form asp-controller="Cart" asp-action="Add" method="post"><input type="hidden" name="id" value="@book.Id"/><button class="button small" type="submit" disabled="@(book.Stock<1)">@(book.Stock<1?"Out of stock":"Add to cart")</button></form></article>}</div>
