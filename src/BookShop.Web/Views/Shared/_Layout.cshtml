<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · LapCare BookShop</title><meta name="description" content="Browse books, discover new reads and order from LapCare BookShop."/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body><header><a class="brand" asp-controller="Home" asp-action="Index">📚 LapCare <span>BookShop</span></a><nav><a asp-controller="Books" asp-action="Index">Books</a><a asp-controller="Cart" asp-action="Index">Cart</a>@if(User.Identity?.IsAuthenticated == true){<span>Hello, @User.Identity.Name</span>@if(User.IsInRole("Admin")){<a href="/admin">Admin</a>}<form asp-controller="Account" asp-action="Logout" method="post"><button class="link">Sign out</button></form>}else{<a asp-controller="Account" asp-action="Login">Sign in</a><a class="nav-button" asp-controller="Account" asp-action="Register">Create account</a>}</nav></header><main>@if(TempData["Success"] is string ok){<div class="notice">@ok</div>}@if(TempData["Error"] is string err){<div class="error">@err</div>}@RenderBody()</main><footer><div>LapCare BookShop</div><small>Thoughtful reads, delivered with care.</small></footer>@await RenderSectionAsync("Scripts", required: false)</body></html>
