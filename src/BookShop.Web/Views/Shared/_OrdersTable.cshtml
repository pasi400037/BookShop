@model IEnumerable<ShopOrder>
<div class="table-wrap"><table><thead><tr><th>Order</th><th>Customer</th><th>Date</th><th>Total</th><th>Payment</th><th>Fulfillment</th><th></th></tr></thead><tbody>@foreach(var o in Model){<tr><td>@o.Number</td><td>@o.RecipientName <small>@o.User?.Email</small></td><td>@o.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</td><td>₹@o.Total.ToString("0.00")</td><td>@o.PaymentStatus · @o.PaymentMethod</td><td>@o.FulfillmentStatus</td><td><form method="post" action="/admin/orders/@o.Id/status"><select name="status">@foreach(var s in new[]{"New","Processing","Shipped","Completed","Cancelled"}){<option selected="@(s==o.FulfillmentStatus)" value="@s">@s</option>}</select><button class="button small">Update</button></form></td></tr>}</tbody></table></div>
