@model IReadOnlyList<ShopBook>
@{ ViewData["Title"]="Your cart"; var quantities=(Dictionary<string,int>)ViewBag.Entries; decimal total=0; }
<section class="page-heading"><p class="eyebrow">YOUR BOOKS</p><h1>Your cart</h1></section>
@if(!Model.Any()){<div class="empty"><h2>Your cart is waiting for a good book.</h2><a class="button" asp-controller="Books" asp-action="Index">Browse books</a></div>}else{<div class="cart-list">@foreach(var b in Model){var q=quantities[b.Id];total+=b.Price*q;<article class="cart-row"><img src="@b.ImagePath" alt=""/><div class="grow"><h3>@b.Title</h3><p class="muted">₹@b.Price.ToString("0.00") each</p></div><form asp-action="Update" method="post"><input type="hidden" name="id" value="@b.Id"/><input name="quantity" type="number" min="0" max="20" value="@q"/><button class="button secondary">Update</button><small>Set quantity to 0 to remove</small></form><strong>₹@((b.Price*q).ToString("0.00"))</strong></article>}</div><div class="cart-total"><span>Subtotal</span><strong>₹@total.ToString("0.00")</strong></div><div class="actions"><a asp-controller="Books" asp-action="Index">Continue shopping</a><a class="button" asp-action="Checkout">Continue to checkout</a></div>}
