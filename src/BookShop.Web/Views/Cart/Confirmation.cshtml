@model ShopOrder
@{ ViewData["Title"]="Order received"; }
<section class="form-card narrow"><p class="eyebrow">ORDER @Model.Number</p><h1>Thank you, @Model.RecipientName.</h1><p>Your order has been saved. Payment: <b>@Model.PaymentStatus</b>. Fulfillment: <b>@Model.FulfillmentStatus</b>.</p><div class="order-lines">@foreach(var line in Model.Items){<div><span>@line.Title × @line.Quantity</span><b>₹@((line.UnitPrice*line.Quantity).ToString("0.00"))</b></div>}</div><div class="cart-total"><span>Total</span><b>₹@Model.Total.ToString("0.00")</b></div><a class="button" asp-controller="Books" asp-action="Index">Continue browsing</a></section>
