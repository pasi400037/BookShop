@model CheckoutInput
@{ ViewData["Title"]="Checkout"; var payuReady=!string.IsNullOrWhiteSpace(Environment.GetEnvironmentVariable("PayU__Key"))&&!string.IsNullOrWhiteSpace(Environment.GetEnvironmentVariable("PayU__Salt")); }
<section class="form-card"><p class="eyebrow">ALMOST THERE</p><h1>Delivery and payment</h1><form method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="error"></div><div class="form-grid"><label>Recipient name<input asp-for="RecipientName"/></label><label>Phone<input asp-for="Phone"/></label><label class="wide">Delivery address<textarea asp-for="Address"></textarea></label><label>City<input asp-for="City"/></label><label>State<input asp-for="State"/></label><label>Postal code<input asp-for="PostalCode"/></label><label>Payment<select asp-for="PaymentMethod"><option value="COD">Cash on delivery</option>@if(payuReady){<option value="PayU">PayU online payment</option>}</select></label></div><p class="muted">Online payment appears only after the shop owner configures PayU credentials.</p><button class="button">Place order</button></form></section>
