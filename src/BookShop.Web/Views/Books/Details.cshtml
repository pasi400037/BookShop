@model ShopBook
@{ ViewData["Title"] = Model.Title; }
<div class="detail"><img src="@Model.ImagePath" alt="Cover of @Model.Title"/><div><a asp-action="Index" class="muted">← Browse books</a><p class="eyebrow">@Model.Category · @Model.Language</p><h1>@Model.Title</h1><p class="muted">by @Model.Author</p><p>@Model.Description</p><dl><dt>Publisher</dt><dd>@Model.Publisher</dd><dt>Edition</dt><dd>@Model.Edition</dd><dt>Genres</dt><dd>@Model.Genres</dd></dl><div class="price-row"><strong>₹@Model.Price.ToString("0.00")</strong>@if(Model.ListPrice>Model.Price){<del>₹@Model.ListPrice.ToString("0.00")</del>}</div><p>@Model.Stock available</p><form asp-controller="Cart" asp-action="Add" method="post"><input type="hidden" name="id" value="@Model.Id"/><label>Quantity <input name="quantity" type="number" min="1" max="@Math.Max(1,Model.Stock)" value="1"/></label><button class="button" disabled="@(Model.Stock<1)">Add to cart</button></form></div></div>
